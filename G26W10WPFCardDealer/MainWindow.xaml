<Window x:Class="G26W10WPFCardDealer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="카드 딜러"
        Height="550"
        Width="900">

    <Grid Background="#004400">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 카드 이미지 출력 -->
        <UniformGrid Grid.Row="0"
                     Rows="1"
                     Columns="5"
                     Margin="20">

            <Image x:Name="Card1" Stretch="Uniform"/>
            <Image x:Name="Card2" Stretch="Uniform"/>
            <Image x:Name="Card3" Stretch="Uniform"/>
            <Image x:Name="Card4" Stretch="Uniform"/>
            <Image x:Name="Card5" Stretch="Uniform"/>

        </UniformGrid>

        <!-- 족보 판별 결과 -->
        <StackPanel Grid.Row="1" Margin="10">

            <TextBlock x:Name="ResultText"
                       Text="카드를 분배해주세요."
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="ExpectedText"
                       FontSize="18"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="5"/>

            <TextBlock x:Name="TestResultText"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="5"/>

        </StackPanel>

        <!-- 랜덤 카드 분배 -->
        <Button Grid.Row="2"
                Content="랜덤 카드 분배"
                Height="40"
                Margin="20,5"
                Click="OnDeal"/>

        <!-- 족보 테스트 -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="20">

            <ComboBox x:Name="HandComboBox"
                      Width="220"
                      Height="40"
                      FontSize="16"/>

            <Button Content="족보 테스트"
                    Width="130"
                    Height="40"
                    Margin="10,0"
                    Click="OnTest"/>

            <Button Content="다음 족보"
                    Width="130"
                    Height="40"
                    Click="OnNextTest"/>

        </StackPanel>

    </Grid>
</Window>