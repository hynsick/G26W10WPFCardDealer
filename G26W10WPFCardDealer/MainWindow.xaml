<Window x:Class="G26W10WPFCardDealer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="카드 딜러"
        Height="550"
        Width="900">

    <Grid Background="#004400">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 카드 이미지 출력 -->
        <ItemsControl Grid.Row="0"
                      ItemsSource="{Binding CardResource}"
                      Margin="20">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="5"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Image Source="{Binding}"
                           Stretch="Uniform"
                           Margin="5"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

        <!-- 족보 판별 결과 -->
        <StackPanel Grid.Row="1" Margin="10">

            <TextBlock Text="{Binding ResultText}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding ExpectedText}"
                       FontSize="18"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="5"/>

            <TextBlock Text="{Binding TestResultText}"
                       Foreground="{Binding TestResultColor}"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="5"/>

        </StackPanel>

        <!-- 랜덤 카드 분배 -->
        <Button Grid.Row="2"
                Content="랜덤 카드 분배"
                Command="{Binding DealCardsCommand}"
                Height="40"
                Margin="20,5"/>

        <!-- 족보 테스트 -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="20">

            <ComboBox ItemsSource="{Binding HandNames}"
                      SelectedIndex="{Binding SelectedIndex,
                                              Mode=TwoWay}"
                      Width="220"
                      Height="40"
                      FontSize="16"/>

            <Button Content="족보 테스트"
                    Command="{Binding TestHandCommand}"
                    Width="130"
                    Height="40"
                    Margin="10,0"/>

            <Button Content="다음 족보"
                    Command="{Binding NextTestCommand}"
                    Width="130"
                    Height="40"/>

        </StackPanel>

    </Grid>
</Window>